# Copy to .env.local. EXPO_PUBLIC_* values are baked into the app and are NOT secret.

# Base URL of the app's own backend. Empty: the app runs without one.
EXPO_PUBLIC_API_BASE_URL=

# internal | acceptance | production
EXPO_PUBLIC_ENVIRONMENT=internal

# demo (no account needed, refused in production) | azure-ad
EXPO_PUBLIC_AUTH_PROVIDER=demo

# Only for azure-ad sign-in (docs/decisions/0012).
EXPO_PUBLIC_AZURE_AD_TENANT_ID=
EXPO_PUBLIC_AZURE_AD_CLIENT_ID=
EXPO_PUBLIC_AZURE_AD_REDIRECT_URL=
EXPO_PUBLIC_AZURE_AD_SCOPES=

# production | sandbox (bunq's test environment with play money, docs/decisions/0018)
EXPO_PUBLIC_BUNQ_ENVIRONMENT=production

# Only for EAS Build/Update.
EXPO_PUBLIC_EAS_PROJECT_ID=
